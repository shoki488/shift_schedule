<header>
  <div class="header_all"> 
    <nav class="button_menu">
      <a class="Shift_Schedule" href="/">Shift Schedule</a>
      <div class="login_line">
        <% if user_signed_in? %>
          <div class="dropdown-center dropstart">
            <button class="btn-primary btn-sm dropdown-toggle guest" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false"> 
              <% if current_user.guest? %>
                <p class="guest_button">ゲスト</p>
              <% else %>
                <p class="current_name"><%= current_user.name %></p>
              <% end %>
            </button>
            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
              <div class="sub-menu">
                <p class="main-menu"><a class="dropdown-item" href="/">ホーム</a></p>
              </div>
              <li><hr class="dropdown-divider"></li>
              <div class="sub-menu">
                <p class="main-menu">シフト関連</p>
                <li><a class="dropdown-item" href="/shifts">シフト一覧</a></li>
                <li><a class="dropdown-item" href="/shifts/new">シフト作成</a></li>
                <li><%= link_to "シフト希望登録", new_shift_preference_path, class: "dropdown-item" %></li>
                <li><%= link_to "シフト希望詳細", shift_preference_path(current_user), class: "dropdown-item" %></li>
                <% if current_user.classification == "リーダー" %>
                  <li><%= link_to "シフト希望一覧", shift_preferences_path, class: "dropdown-item" %></li>
                <% end %>
              </div>
              <li><hr class="dropdown-divider"></li>
              <div class="sub-menu">
                <p class="main-menu">myページ</p>
                <li><a class="dropdown-item" href="/users/edit">アカウント変更</a></li>
                <li><a class="dropdown-item" href="/users/account">アカウント詳細</a></li>
                <li><%= link_to "お気に入りシフト", favorite_user_path(current_user), class: "dropdown-item" %></li>
              </div>
            </ul>
        <% else %>
          <%= link_to "お困りの方", question_path, class: "btn btn-primary", role: "button", id: "question"%>
        <% end %>
      </div>
    </nav>
  </div>
</header>
<%= alert %>
