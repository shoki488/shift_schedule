<div class="container">
  <h1 class="title">シフト一覧ページ</h1>
  <%= render "shared/search" %>
  <div class="sort-options">
    <%= form_tag shifts_path, method: :get do %>
      <%= select_tag :sort, options_for_select([
        ['日付（昇順）', 'date_asc'],
        ['日付（降順）', 'date_desc'],
        ], params[:sort]), prompt: '作成順', onchange: 'this.form.submit()', id: 'sort' %>
    <% end %>
  </div>
  <div class="shifts-grid">
    <% @shifts.each do |shift| %>
      <div class="shift-card">
        <h3><%= shift.calendar %>予定シフト</h3>
        <div class="shift-content">
          <%= raw shift.content %>
        </div>
        <div class="shift-actions">
          <% if current_user.favorites.exists?(shift: shift) %>
            <%= button_to "お気に入り解除", shift_favorite_path(shift), method: :delete, remote: true, class: "btn btn-secondary btn-sm" %>
          <% else %>
            <%= button_to "お気に入り登録", shift_favorite_path(shift), method: :post, remote: true, class: "btn btn-primary btn-sm" %>
          <% end %>
          <% if current_user.classification == "リーダー" %>
            <%= link_to "シフト作成", new_shift_path(shift), class: "btn btn-primary btn-sm" %>
            <%= link_to "シフト詳細", shift_path(shift), class: "btn btn-primary btn-sm" %>
            <%= button_to "シフト削除", shift, method: :delete, data: { confirm: "本当に削除しますか？" }, class: "btn btn-danger btn-sm" %>
          <% end %>
        </div>
         <p>シフト作成者: <%= shift.creator %></p>
      </div>
    <% end %>
  </div>
</div>
